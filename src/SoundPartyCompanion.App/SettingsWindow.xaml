<Window x:Class="SoundPartyCompanion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Party Companion 设置"
        Icon="pack://application:,,,/SoundPartyCompanion.App;component/Assets/app.ico"
        Width="416"
        Height="476"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F3EFE9"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Closed="HandleWindowClosed">
    <Window.Resources>
        <Style x:Key="SettingsFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Rectangle Margin="2" Stroke="#AAA49B" StrokeThickness="1" StrokeDashArray="2,2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#F3EFE9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="SwitchTrack" Grid.Column="1" Width="32" Height="20"
                                    VerticalAlignment="Center" Background="#4C4842" CornerRadius="10">
                                <Ellipse x:Name="SwitchKnob" Width="14" Height="14" Margin="3"
                                         Fill="#F3EFE9" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#B06B50" />
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderRailStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="#47443D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsOpacitySliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#B06B50"
                                                  Style="{StaticResource SettingsSliderRailStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Ellipse Fill="#F3EFE9" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SettingsSliderRailStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Margin="0,1" Background="#706C6862" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#AAA49B" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#C79C6044" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="0,5,4,5" Background="Transparent">
                            <Border Width="2" HorizontalAlignment="Center" Background="#252321" CornerRadius="1" Opacity="0.65" />
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SettingsPageButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SettingsPageButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="10"
                                       Style="{StaticResource SettingsScrollBarStyle}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="SettingsSurface" Margin="14" Background="#171716" BorderBrush="#30F3EFE9" BorderThickness="1" CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28" Color="#000000" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Grid Margin="22,0,22,0" MouseLeftButtonDown="HandleWindowDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Medium" Text="设置" />
                <Button x:Name="CloseSettingsButton" Grid.Column="1" Width="36" Height="36" Padding="0" Background="Transparent"
                        FocusVisualStyle="{StaticResource SettingsFocusStyle}" AutomationProperties.Name="关闭设置"
                        Click="HandleCloseClick" Content="×" FontSize="20" ToolTip="关闭设置" />
            </Grid>

            <ScrollViewer x:Name="SettingsScrollViewer"
                          Grid.Row="1"
                          Margin="0,0,8,0"
                          Style="{StaticResource SettingsScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          IsDeferredScrollingEnabled="False"
                          PanningMode="VerticalOnly"
                          PreviewMouseWheel="HandleSettingsMouseWheel"
                          PreviewMouseLeftButtonDown="HandleScrollPointerDown"
                          ScrollChanged="HandleSettingsScrollChanged">
                <StackPanel Margin="22,0,4,12">
                    <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#AAA49B" Text="常规" />
                    <CheckBox x:Name="StartupToggle" Style="{StaticResource SettingsToggleStyle}"
                              Content="登录 Windows 后启动" AutomationProperties.Name="登录 Windows 后启动"
                              IsChecked="{Binding StartWithWindows}" />
                    <CheckBox x:Name="OfflineCollapseToggle" Style="{StaticResource SettingsToggleStyle}"
                              Content="离线时自动收为图标" AutomationProperties.Name="离线时自动收为图标"
                              IsChecked="{Binding AutoCollapseOffline}" />
                    <CheckBox x:Name="AlwaysOnTopToggle" Style="{StaticResource SettingsToggleStyle}"
                              Content="组件始终置顶" AutomationProperties.Name="组件始终置顶"
                              IsChecked="{Binding AlwaysOnTop}" />

                    <Border Height="1" Margin="0,12,0,12" Background="#36332E" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="组件不透明度" />
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#AAA49B"
                                   Text="{Binding WindowOpacity, StringFormat={}{0:P0}}" />
                    </Grid>
                    <Slider x:Name="OpacitySlider" Margin="0,8,0,0" Minimum="0.65" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                            Style="{StaticResource SettingsOpacitySliderStyle}" AutomationProperties.Name="组件不透明度"
                            Value="{Binding WindowOpacity, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid x:Name="ComponentPositionRow" Margin="0,8,0,0" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ComponentPositionLabel" Text="组件位置" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" FontSize="11" Foreground="#AAA49B"
                                       VerticalAlignment="Center" Text="拖动后自动记忆" />
                        </StackPanel>
                        <Button Grid.Column="1" Height="32" Padding="9,4" FontSize="12" Content="重置位置"
                                VerticalAlignment="Center"
                                FocusVisualStyle="{StaticResource SettingsFocusStyle}" Command="{Binding ResetPositionCommand}" />
                    </Grid>

                    <Border Height="1" Margin="0,12,0,12" Background="#36332E" />
                    <CheckBox x:Name="LowBatteryToggle" Style="{StaticResource SettingsToggleStyle}"
                              Content="低电量提醒" AutomationProperties.Name="低电量提醒"
                              IsChecked="{Binding LowBatteryNotifications}" />
                    <TextBlock x:Name="LowBatteryHint" Margin="0,2,0,6" FontSize="11" Foreground="#AAA49B" TextWrapping="Wrap"
                               Text="20% / 10% · 同一放电区间不重复提醒" />
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="SettingsFooter" Grid.Row="2" Margin="22,0,22,0" BorderBrush="#36332E" BorderThickness="0,1,0,0">
                <TextBlock x:Name="SettingsSaveHint" VerticalAlignment="Center" FontSize="11" Foreground="#AAA49B"
                           Text="本地设置 · 自动保存" />
            </Border>
        </Grid>
    </Border>
</Window>
